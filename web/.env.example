# Admin auth — single shared password gate.
# Rotate ADMIN_SESSION_SECRET to invalidate every existing session.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-with-node--require-crypto--randomBytes-32-toString-hex

# Site origin used for CSRF check on /api/admin/login.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Comma-separated list of origins allowed to POST to /api/contact and /api/track.
# Defaults to NEXT_PUBLIC_SITE_ORIGIN if unset.
PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://elenos.ai

# Supabase (server-side service role — never expose client-side).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt used to hash visitor IPs before storage. Any non-empty random string works.
IP_HASH_SALT=

# Discord webhook — receives notifications for new contact form submissions
# and new newsletter subscribers. Leave blank to disable.
# Create one in Discord: Server Settings → Integrations → Webhooks → New Webhook
# DISCORD_WEBHOOK_URL=
# Optional per-channel overrides (fall back to DISCORD_WEBHOOK_URL):
# DISCORD_WEBHOOK_URL_CONTACTS=
# DISCORD_WEBHOOK_URL_SUBSCRIBERS=
# DISCORD_WEBHOOK_URL_LEADS=
# DISCORD_WEBHOOK_URL_TICKETS=

# /learn funnel — unlock email (guide PDF + Discord invite).
# Resend: create an API key at resend.com and verify the elenos.ai domain.
# Leave RESEND_API_KEY blank to disable sending; leads are still captured and
# the API returns the Discord invite directly as a fallback.
RESEND_API_KEY=
LEAD_FROM_EMAIL=Elenos <ed@elenos.ai>
# Where the guide PDF is hosted (use an unguessable URL, e.g. Supabase Storage).
LEAD_PDF_URL=
DISCORD_INVITE_URL=https://discord.gg/UH3a34eUvd

# /course sales — Stripe Payment Link checkout.
# Signing secret from the Stripe dashboard: Developers → Webhooks → your
# endpoint (https://admin.elenos.ai/api/stripe/webhook/), event
# checkout.session.completed.
STRIPE_WEBHOOK_SECRET=
# Module PDFs delivered by email after purchase, as a JSON array (one line).
# Use unguessable URLs (e.g. Supabase Storage or /content/ with random suffixes).
# COURSE_PDF_LINKS=[{"title":"01 — Pick your lane","url":"https://..."},{"title":"02 — Build the offer","url":"https://..."}]
COURSE_PDF_LINKS=
# Discord channel for sale notifications (falls back to DISCORD_WEBHOOK_URL).
# DISCORD_WEBHOOK_URL_SALES=

# /book scheduler — custom booking system (Calendly replacement).
# Google Calendar OAuth for a single owner account. One-time setup:
#   1. console.cloud.google.com → new project → enable "Google Calendar API"
#   2. OAuth consent screen (External, add yourself as a test user)
#   3. Create OAuth client (type: Web application), add redirect
#      http://localhost:53682/oauth2callback
#   4. Run: node scripts/get-google-token.mjs   (mints GOOGLE_REFRESH_TOKEN)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to read free/busy and write events to. Default "primary".
GOOGLE_CALENDAR_ID=primary
# Discord channel for new-booking notifications (falls back to DISCORD_WEBHOOK_URL).
# DISCORD_WEBHOOK_URL_BOOKINGS=
# Public origin where /book and /book/manage live (used in booking emails).
BOOKING_SITE_ORIGIN=https://elenos.ai
